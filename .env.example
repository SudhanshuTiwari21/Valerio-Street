# ─── Database ──────────────────────────────────────────────────────────
# Use Neon, Supabase or any Postgres. Connection-pooled URL recommended.
DATABASE_URL="postgresql://user:password@host:5432/valerio_street?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/valerio_street?sslmode=require"

# ─── Auth.js / NextAuth ────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── SMTP (Titan Email / GoDaddy) ───────────────────────────────────────
# Titan typically supports: host=smtp.titan.email port=465 (secure) or 587 (starttls)
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@yourdomain.com"
SMTP_PASS=""
SMTP_FROM="Valerio Street <atelier@yourdomain.com>"

# ─── Razorpay ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Valerio Street"

# (Optional) Resend could be added later. Titan SMTP is supported by default.
