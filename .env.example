# ─── Database ──────────────────────────────────────────────────────────
# Use Neon, Supabase or any Postgres. Connection-pooled URL recommended.
DATABASE_URL="postgresql://user:password@host:5432/valerio_street?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/valerio_street?sslmode=require"

# ─── Auth.js / NextAuth ────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Resend recommended) ─────────────────────────────────────────
# When RESEND_API_KEY is set, the app sends via Resend’s HTTP API (no SMTP).
# Verify your domain in the Resend dashboard; FROM must use that domain (or Resend’s test sender).
# https://resend.com/docs/dashboard/domains/introduction
#
RESEND_API_KEY=""
# Example after domain verify: Valerio Street <noreply@yourdomain.com>
RESEND_FROM="Valerio Street <onboarding@resend.dev>"
# Inbox for /api/contact (defaults to the public support address in src/lib/site.ts).
# CONTACT_TO="support@yourdomain.com"

# ─── SMTP (optional fallback if Resend fails, or if RESEND_API_KEY is unset) ─
# Titan / GoDaddy often returns 535 on app servers even when webmail works — Resend avoids that.
# Host: smtp.titan.email — use the full mailbox email for SMTP_USER.
#
# Port 465 = implicit TLS; 587 = STARTTLS (app sets requireTLS for 587).
#
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@yourdomain.com"
SMTP_PASS=""
SMTP_FROM="Valerio Street <atelier@yourdomain.com>"
# SMTP_AUTH_METHOD="LOGIN"

# ─── Razorpay ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Valerio Street"

